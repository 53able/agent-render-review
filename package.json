{
  "name": "render-director",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Review surface for ADE agents rendering with vork",
  "scripts": {
    "start": "node server.mts",
    "mcp": "node mcp.mts",
    "build": "node scripts/build.mts",
    "prepare": "node scripts/build.mts",
    "dev": "vite --config vite.config.mts",
    "typecheck": "tsc -p . && tsc -p tsconfig.web.json",
    "pretest": "npm run build",
    "test": "npm run test:unit && node test/build-guard.mts && node test/integration.mts",
    "test:unit": "node server.mts --selftest && node test/director.mts && node test/review-model.mts && node test/log.mts && node test/http.mts && node test/build-id.mts && node test/swap-dist.mts && node test/web-lib.mts && node test/web-lint.mts && node test/contrast.mts",
    "pretest:e2e": "npm run build",
    "test:e2e": "node test/e2e.mts",
    "report": "node server.mts --report"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@logtape/logtape": "2.4.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.56.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "0.5.2",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
