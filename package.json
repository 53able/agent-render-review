{
  "name": "render-director",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Review surface for ADE agents rendering with vork",
  "scripts": {
    "start": "node server.mts",
    "mcp": "node mcp.mts",
    "typecheck": "tsc -p . && tsc -p tsconfig.public.json",
    "test": "npm run test:unit && node test/integration.mts",
    "test:unit": "node server.mts --selftest && node test/director.mts && node test/review-model.mts",
    "test:e2e": "node test/e2e.mts",
    "report": "node server.mts --report"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.56.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
